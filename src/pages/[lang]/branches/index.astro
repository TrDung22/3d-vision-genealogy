---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Sparkline from '../../../components/Sparkline.astro';
import { buildGraph } from '../../../lib/graph';
import { LOCALES, t, type Lang } from '../../../lib/i18n';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const root = `${base}/${lang}`;

const branches = (await getCollection('branches')).sort((a, b) => a.data.order - b.data.order);
const graph = await buildGraph(lang);
const nodeById = new Map(graph.nodes.map((n) => [n.id, n]));
const allYears = graph.nodes.map((n) => n.year);
const minYear = Math.min(...allYears);
const maxYear = Math.max(...allYears);

const cards = branches.map((b) => {
  const nodes = graph.nodes.filter((n) => n.branch === b.id);
  const ys = nodes.map((n) => n.year);
  const cross = graph.edges.filter((e) => {
    const s = nodeById.get(e.source)!.branch;
    const tt = nodeById.get(e.target)!.branch;
    return s !== tt && (s === b.id || tt === b.id);
  }).length;
  const laneCount = new Map<string, number>();
  for (const n of nodes) laneCount.set(n.lane, (laneCount.get(n.lane) ?? 0) + 1);
  return {
    b,
    count: nodes.length,
    years: ys,
    span: ys.length ? `${Math.min(...ys)}–${Math.max(...ys)}` : '—',
    cross,
    lanes: b.data.lanes.map((l) => ({ title: l.title, n: laneCount.get(`${b.id}/${l.id}`) ?? 0 })),
  };
});
const sparkMax = Math.max(
  1,
  ...cards.flatMap((c) => {
    const m = new Map<number, number>();
    c.years.forEach((y) => m.set(y, (m.get(y) ?? 0) + 1));
    return [...m.values()];
  }),
);
---

<Base title={t(lang, 'nav.branches')} lang={lang}>
  <header class="page-head">
    <p class="eyebrow">{t(lang, 'branches.kicker')}</p>
    <h1>{t(lang, 'branches.title')}</h1>
    <p class="lede">{t(lang, 'branches.intro')}</p>
  </header>

  <div class="branch-grid">
    {
      cards.map(({ b, count, years, span, cross, lanes }, i) => (
        <a class="card branch" href={`${root}/branches/${b.id}/`} style={`--bc: ${b.data.color}`}>
          <div class="branch-top">
            <span class="eyebrow">
              <span class="branch-dot" />
              0{i + 1} · {b.data.status === 'active' ? t(lang, 'branches.growing') : t(lang, 'branches.planned')}
            </span>
            <span class="branch-span mono">{span}</span>
          </div>
          <h2>{b.data.title}</h2>
          <p class="branch-tagline">{b.data.tagline}</p>
          <Sparkline years={years} from={minYear} to={maxYear} max={sparkMax} color={b.data.color} height={40} />
          <dl class="branch-stats">
            <div><dd>{count}</dd><dt>{t(lang, 'table.nodes')}</dt></div>
            <div><dd>{lanes.length}</dd><dt>{t(lang, 'branches.lanes')}</dt></div>
            <div><dd>{cross}</dd><dt>{t(lang, 'branches.cross')}</dt></div>
          </dl>
          <ul class="branch-lanes">
            {lanes.map((l) => (
              <li>
                {l.title} <span class="mono">{l.n}</span>
              </li>
            ))}
          </ul>
        </a>
      ))
    }
  </div>
</Base>

<style>
  .page-head {
    max-width: 820px;
    margin-bottom: 2.5rem;
  }

  .page-head h1 {
    margin: 0.6rem 0 0.9rem;
  }

  .branch-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .branch {
    display: flex;
    flex-direction: column;
    padding: 1.6rem 1.7rem 1.5rem;
    border-top: 2px solid var(--bc);
    background:
      radial-gradient(520px 220px at 100% 0%, color-mix(in srgb, var(--bc) 10%, transparent), transparent 70%),
      var(--surface);
  }

  .branch-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .branch-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--bc);
  }

  .branch-span {
    font-size: 0.74rem;
    color: var(--muted);
  }

  .branch h2 {
    margin: 0.9rem 0 0.5rem;
    font-size: clamp(2rem, 3.4vw, 2.7rem);
    line-height: 1.02;
  }

  .branch-tagline {
    margin: 0 0 1.6rem;
    font-size: 0.98rem;
    line-height: 1.55;
    max-width: 50ch;
  }

  .branch-stats {
    display: flex;
    gap: 2rem;
    margin: 1.2rem 0 1rem;
  }

  .branch-stats dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 2rem;
    line-height: 1;
    color: var(--ink);
  }

  .branch-stats dt {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .branch-lanes {
    list-style: none;
    margin: auto 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .branch-lanes li {
    font-size: 0.76rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--ring);
    color: var(--ink-2);
  }

  .branch-lanes .mono {
    margin-left: 0.25rem;
    font-size: 0.68rem;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .branch-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
