---
/**
 * The heresies page — everything on it is DERIVED from the genealogy's
 * non-linear edges (challenges / independent / revives), never hand-written:
 * adding such an edge to any node YAML grows this page automatically.
 */
import Base from '../../layouts/Base.astro';
import EdgeGlyph from '../../components/EdgeGlyph.astro';
import { buildGraph, independentWaves } from '../../lib/graph';
import { LOCALES, t, type Lang } from '../../lib/i18n';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const root = `${base}/${lang}`;

const graph = await buildGraph(lang);
const nodeById = new Map(graph.nodes.map((n) => [n.id, n]));
const branchById = new Map(graph.branches.map((b) => [b.id, b]));
const colorOf = (nodeId: string) =>
  branchById.get(nodeById.get(nodeId)?.branch ?? '')?.color ?? 'var(--muted)';
const nameOf = (s: string) =>
  s
    .replace(/\s*\((19|20)\d{2}\)\s*$/, '')
    .replace(/\s+(19|20)\d{2}\)$/, ')')
    .replace(/\s+(19|20)\d{2}$/, '');

type Edge = (typeof graph.edges)[number];

// --- challenges, grouped by the challenger (the newer endpoint of the edge)
const challengesBy = new Map<string, Edge[]>();
for (const e of graph.edges) {
  if (e.type !== 'challenges') continue;
  challengesBy.set(e.target, [...(challengesBy.get(e.target) ?? []), e]);
}
const challengers = [...challengesBy.entries()]
  .map(([id, edges]) => ({ node: nodeById.get(id)!, edges }))
  .sort((a, b) => a.node.year - b.node.year);

// --- independent edges → connected components = simultaneous "waves"
const waves = independentWaves(graph);

// --- revives, with the gap each one closed
const revivals = graph.edges
  .filter((e) => e.type === 'revives')
  .map((e) => ({ note: e.note, old: nodeById.get(e.source)!, reviver: nodeById.get(e.target)! }))
  .sort((a, b) => a.reviver.year - b.reviver.year);
const years = graph.nodes.map((n) => n.year);
const minYear = Math.min(...years);
const maxYear = Math.max(...years);
const pct = (y: number) => ((y - minYear) / (maxYear - minYear)) * 100;

const olderFirst = (e: Edge) =>
  [nodeById.get(e.source)!, nodeById.get(e.target)!].sort((a, b) => a.year - b.year);

// --- adaptive branch grouping: with one branch each section stays flat;
// once a section involves several, cards get branch subheadings — and stories
// SPANNING branches (the rare, good kind) get their own group instead of
// being filed under one side arbitrarily.
type Branch = (typeof graph.branches)[number];
type Grouped<T> = { branch: Branch | null; items: T[] };

const sameBranch = (ids: string[]): string | null => {
  const set = new Set(ids.map((id) => nodeById.get(id)?.branch));
  return set.size === 1 ? ([...set][0] ?? null) : null;
};

function groupByBranch<T>(items: T[], branchOf: (item: T) => string | null): Grouped<T>[] {
  const buckets = new Map<string, T[]>();
  for (const it of items) {
    const k = branchOf(it) ?? '·cross·';
    buckets.set(k, [...(buckets.get(k) ?? []), it]);
  }
  const groups: Grouped<T>[] = graph.branches
    .filter((b) => buckets.has(b.id))
    .map((b) => ({ branch: b, items: buckets.get(b.id)! }));
  if (buckets.has('·cross·')) groups.push({ branch: null, items: buckets.get('·cross·')! });
  return groups;
}

const challengerGroups = groupByBranch(challengers, (c) =>
  sameBranch([c.node.id, ...c.edges.map((e) => e.source)]),
);
const waveGroups = groupByBranch(waves, (w) => sameBranch(w.members.map((m) => m.id)));
const revivalGroups = groupByBranch(revivals, (r) => sameBranch([r.old.id, r.reviver.id]));

const chapters = [
  { id: 'heresies', n: challengers.reduce((s, c) => s + c.edges.length, 0), unit: t(lang, 'home.challenges'), title: t(lang, 'heresies.challenges.title'), type: 'challenges' as const },
  { id: 'ripe', n: waves.length, unit: t(lang, 'home.waves'), title: t(lang, 'heresies.independent.title'), type: 'independent' as const },
  { id: 'revivals', n: revivals.length, unit: t(lang, 'home.revivals'), title: t(lang, 'heresies.revives.title'), type: 'revives' as const },
];
const plainTitle = t(lang, 'heresies.title').replace(/<[^>]+>/g, '').replace('&amp;', '&');
---

<Base title={plainTitle} lang={lang} description={t(lang, 'heresies.meta')}>
  <header class="page-head">
    <p class="eyebrow">{t(lang, 'heresies.kicker')}</p>
    <h1 set:html={t(lang, 'heresies.title')} />
    <p class="lede">{t(lang, 'heresies.intro')}</p>
  </header>

  <nav class="chapters" aria-label="Chapters">
    {
      chapters.map((c, i) => (
        <a class={`card chapter chapter-${c.type}`} href={`#${c.id}`}>
          <span class="chapter-n mono">0{i + 1}</span>
          <span class="chapter-count">{c.n}</span>
          <span class="chapter-unit">{c.unit}</span>
          <span class="chapter-title">
            <EdgeGlyph type={c.type} width={30} /> {c.title}
          </span>
        </a>
      ))
    }
  </nav>

  <section class="h-section" id="heresies">
    <div class="section-head">
      <p class="eyebrow">01 · {graph.edgeTypes.challenges.label}</p>
      <h2>{t(lang, 'heresies.challenges.title')}</h2>
      <p>{t(lang, 'heresies.challenges.intro')}</p>
    </div>
    {
      challengerGroups.map((g) => (
        <>
          {challengerGroups.length > 1 && (
            <h3 class="h-branch">
              {g.branch ? (
                <span class="chip">
                  <span class="dot" style={`background:${g.branch.color}`} />
                  {g.branch.title}
                </span>
              ) : (
                <span class="h-cross">{t(lang, 'heresies.crossBranch')}</span>
              )}
            </h3>
          )}
          {g.items.map(({ node, edges }) => (
            <article class="card h-card h-challenge">
              <div class="h-who">
                <a class="h-name" href={`${root}/nodes/${node.id}/`}>
                  <span class="h-dot" style={`background:${colorOf(node.id)}`} />
                  {nameOf(node.short)}
                </a>
                <p class="h-venue mono">{node.venue ?? node.year}</p>
                <p class="h-title">{node.title}</p>
              </div>
              <ul class="h-targets">
                {edges.map((e) => (
                  <li>
                    <p class="h-target">
                      <span class="h-verb">{graph.edgeTypes.challenges.label}</span>
                      <a href={`${root}/nodes/${e.source}/`}>
                        <span class="h-dot" style={`background:${colorOf(e.source)}`} />
                        {nameOf(nodeById.get(e.source)?.short ?? e.source)}
                      </a>
                      <span class="h-year mono">{nodeById.get(e.source)?.year}</span>
                    </p>
                    {e.note && <p class="h-note">{e.note}</p>}
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </>
      ))
    }
  </section>

  <section class="h-section" id="ripe">
    <div class="section-head">
      <p class="eyebrow">02 · {graph.edgeTypes.independent.label}</p>
      <h2>{t(lang, 'heresies.independent.title')}</h2>
      <p>{t(lang, 'heresies.independent.intro')}</p>
    </div>
    {
      waveGroups.map((g) => (
        <>
          {waveGroups.length > 1 && (
            <h3 class="h-branch">
              {g.branch ? (
                <span class="chip">
                  <span class="dot" style={`background:${g.branch.color}`} />
                  {g.branch.title}
                </span>
              ) : (
                <span class="h-cross">{t(lang, 'heresies.crossBranch')}</span>
              )}
            </h3>
          )}
          <div class="waves">
            {g.items.map((w) => (
              <article class="card h-card h-wave">
                <p class="h-when">{w.from === w.to ? w.from : `${w.from}–${w.to}`}</p>
                <p class="h-members">
                  {w.members.map((m, i) => (
                    <>
                      {i > 0 && <span class="h-par" aria-hidden="true">∥</span>}
                      <a href={`${root}/nodes/${m.id}/`}>
                        <span class="h-dot" style={`background:${colorOf(m.id)}`} />
                        {nameOf(m.short)}
                      </a>
                    </>
                  ))}
                </p>
                <ul class="h-notes">
                  {w.edges.map((e) => (
                    <li>
                      {w.members.length > 2 && (
                        <span class="h-pair">{olderFirst(e).map((n) => nameOf(n.short)).join(' ∥ ')}</span>
                      )}
                      {e.note && <p class="h-note">{e.note}</p>}
                    </li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </>
      ))
    }
  </section>

  <section class="h-section" id="revivals">
    <div class="section-head">
      <p class="eyebrow">03 · {graph.edgeTypes.revives.label}</p>
      <h2>{t(lang, 'heresies.revives.title')}</h2>
      <p>{t(lang, 'heresies.revives.intro')}</p>
    </div>
    {
      revivalGroups.map((g) => (
        <>
          {revivalGroups.length > 1 && (
            <h3 class="h-branch">
              {g.branch ? (
                <span class="chip">
                  <span class="dot" style={`background:${g.branch.color}`} />
                  {g.branch.title}
                </span>
              ) : (
                <span class="h-cross">{t(lang, 'heresies.crossBranch')}</span>
              )}
            </h3>
          )}
          {g.items.map((r) => (
            <article class="card h-card h-revival">
              <div class="h-gap" aria-hidden="true">
                <span class="h-gap-axis" />
                <span class="h-gap-span" style={`left:${pct(r.old.year)}%; width:${pct(r.reviver.year) - pct(r.old.year)}%`} />
                <span class="h-gap-dot" style={`left:${pct(r.old.year)}%; background:${colorOf(r.old.id)}`} />
                <span class="h-gap-dot" style={`left:${pct(r.reviver.year)}%; background:${colorOf(r.reviver.id)}`} />
                <span class="h-gap-year mono" style={`left:${pct(r.old.year)}%`}>{r.old.year}</span>
                <span class="h-gap-year h-gap-year-end mono" style={`left:${pct(r.reviver.year)}%`}>{r.reviver.year}</span>
              </div>
              <p class="h-gap-n">
                <span class="h-gap-big">{r.reviver.year - r.old.year}</span> {t(lang, 'heresies.yearsDormant')}
              </p>
              <p class="h-revive-line">
                <a href={`${root}/nodes/${r.reviver.id}/`}>{nameOf(r.reviver.short)}</a>
                <em> {graph.edgeTypes.revives.label} </em>
                <a href={`${root}/nodes/${r.old.id}/`}>{nameOf(r.old.short)}</a>
              </p>
              {r.note && <p class="h-note">{r.note}</p>}
            </article>
          ))}
        </>
      ))
    }
  </section>
</Base>

<style>
  .page-head {
    max-width: 860px;
    margin-bottom: 2.5rem;
  }

  .page-head h1 {
    margin: 0.6rem 0 0.9rem;
  }

  .chapters {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
    margin-bottom: 1rem;
  }

  .chapter {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    gap: 0 0.7rem;
    padding: 1.2rem 1.4rem;
  }

  .chapter-n {
    position: absolute;
    top: 1rem;
    right: 1.2rem;
    font-size: 0.7rem;
    color: var(--muted);
  }

  .chapter-count {
    font-family: var(--font-serif);
    font-size: 3rem;
    line-height: 1;
    color: var(--ink);
  }

  .chapter-unit {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .chapter-title {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.7rem;
    color: var(--ink-2);
    font-size: 0.92rem;
  }

  .chapter-challenges {
    background:
      radial-gradient(340px 160px at 100% 0%, color-mix(in srgb, var(--danger) 14%, transparent), transparent 70%),
      var(--surface);
  }

  .h-section {
    padding-top: 4.5rem;
  }

  .h-section .section-head {
    max-width: 760px;
  }

  .h-branch {
    margin: 2.2rem 0 0.8rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .h-branch .chip {
    font-size: inherit;
    color: var(--muted);
  }

  .h-cross {
    color: var(--accent);
  }

  .h-card {
    margin: 0.9rem 0;
    padding: 1.4rem 1.6rem;
  }

  .h-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-right: 0.45rem;
    vertical-align: 0.1em;
  }

  /* heresies: the challenger on the left, what it questions on the right */
  .h-challenge {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.6fr);
    gap: 1.5rem 2.5rem;
    border-left: 2px solid color-mix(in srgb, var(--danger) 70%, transparent);
  }

  .h-name {
    font-family: var(--font-serif);
    font-size: 1.9rem;
    line-height: 1.1;
    color: var(--ink);
  }

  .h-venue {
    margin: 0.5rem 0 0.4rem;
    font-size: 0.72rem;
    color: var(--muted);
  }

  .h-title {
    margin: 0;
    font-size: 0.86rem;
    color: var(--muted);
    line-height: 1.5;
  }

  .h-targets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .h-target {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.2rem 0.6rem;
    margin: 0;
  }

  .h-verb {
    font-style: italic;
    color: var(--danger);
    font-size: 0.86rem;
  }

  .h-target a {
    color: var(--ink);
    font-weight: 600;
  }

  .h-year {
    font-size: 0.72rem;
    color: var(--muted);
  }

  .h-note {
    margin: 0.35rem 0 0;
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--ink-2);
  }

  /* waves: two-up cards */
  .waves {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 0.9rem;
  }

  .h-wave {
    display: flex;
    flex-direction: column;
  }

  .h-when {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 2.2rem;
    line-height: 1;
    color: var(--ink);
  }

  .h-members {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 0.6rem;
    margin: 0.8rem 0 0.3rem;
    font-weight: 600;
  }

  .h-members a {
    color: var(--ink);
  }

  .h-par {
    color: var(--muted);
    font-weight: 400;
  }

  .h-notes {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .h-notes li + li {
    margin-top: 0.8rem;
  }

  .h-pair {
    display: block;
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
  }

  /* revivals: the dormant span drawn on the genealogy's own time scale */
  .h-gap {
    position: relative;
    height: 34px;
    margin: 0.3rem 0.5rem 0.6rem;
  }

  .h-gap-axis {
    position: absolute;
    left: 0;
    right: 0;
    top: 10px;
    border-top: 1px dashed var(--baseline);
  }

  .h-gap-span {
    position: absolute;
    top: 9px;
    height: 3px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--muted), var(--ink));
    opacity: 0.6;
  }

  .h-gap-dot {
    position: absolute;
    top: 5px;
    width: 11px;
    height: 11px;
    margin-left: -5.5px;
    border-radius: 50%;
    box-shadow: 0 0 0 3px var(--surface);
  }

  .h-gap-year {
    position: absolute;
    top: 19px;
    transform: translateX(-50%);
    font-size: 0.68rem;
    color: var(--muted);
  }

  .h-gap-n {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .h-gap-big {
    font-family: var(--font-serif);
    font-size: 2.4rem;
    letter-spacing: 0;
    color: var(--ink);
    margin-right: 0.3rem;
  }

  .h-revive-line {
    margin: 0.5rem 0 0;
    font-size: 1.05rem;
  }

  .h-revive-line a {
    color: var(--ink);
    font-weight: 600;
  }

  .h-revive-line em {
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .chapters {
      grid-template-columns: 1fr;
    }

    .h-challenge {
      grid-template-columns: 1fr;
    }

    .waves {
      grid-template-columns: 1fr;
    }
  }
</style>
