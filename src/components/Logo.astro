---
/**
 * The mark: an isometric cube drawn as a graph — 3D vision as a web of
 * works. Four vertices carry the four branch colors.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: cls } = Astro.props;
---

<svg class={cls} width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true">
  <g stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" opacity="0.55">
    <path d="M16 4 26.4 10v12L16 28 5.6 22V10Z" />
    <path d="M5.6 10 16 16l10.4-6M16 16v12" />
  </g>
  <circle cx="16" cy="4" r="2.6" fill="#3987e5" />
  <circle cx="26.4" cy="10" r="2.6" fill="#199e70" />
  <circle cx="26.4" cy="22" r="2.6" fill="#c98500" />
  <circle cx="5.6" cy="22" r="2.6" fill="#008300" />
  <circle cx="5.6" cy="10" r="1.9" fill="currentColor" />
  <circle cx="16" cy="28" r="1.9" fill="currentColor" />
  <circle cx="16" cy="16" r="3.1" fill="currentColor" />
</svg>
