---
/**
 * "Where the branches meet" — the genealogy in 3D (src/lib/floors3d.js): the
 * atlas unfolds into one glass floor per branch, and the debts between
 * branches become bridges. three.js is its own chunk, loaded as the section
 * approaches; it mirrors the atlas's branch and kind filters (`atlas:filter`).
 */
import Icon from './Icon.astro';
import { buildGraph } from '../lib/graph';
import { graphStrings, t, type Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const root = `${base}/${lang}`;
const graph = await buildGraph(lang);
const branchOf = new Map(graph.nodes.map((n) => [n.id, n.branch]));
const bridges = graph.edges.filter((e) => branchOf.get(e.source) !== branchOf.get(e.target)).length;
const intro = t(lang, 'floors.intro')
  .replace('{bridges}', String(bridges))
  .replace('{debts}', `${graph.edges.length}`);
---

<section class="floors" id="floors" aria-labelledby="floors-title" data-root={root} data-i18n={JSON.stringify(graphStrings(lang))}>
  <div class="container-wide">
    <div class="section-head floors-head">
      <p class="eyebrow">{t(lang, 'floors.kicker')}</p>
      <h2 id="floors-title" set:html={t(lang, 'floors.title')} />
      <p>{intro}</p>
    </div>
    <div class="f3-frame">
      <div class="f3-stage">
        <div class="f3-canvas" id="f3-canvas" role="img" aria-label={t(lang, 'floors.title').replace(/<[^>]+>/g, '')}>
          <p class="f3-loading">{t(lang, 'floors.loading')}</p>
        </div>
        <div class="f3-ui is-folded" id="f3-ui">
          <p class="f3-caption" aria-live="polite">
            <span class="f3-when-folded">{t(lang, 'floors.captionFolded')}</span>
            <span class="f3-when-up">{t(lang, 'floors.captionUp')}</span>
            <span class="f3-when-bridges">{t(lang, 'floors.captionBridges').replace('{n}', String(bridges))}</span>
          </p>
          <div class="f3-controls">
            <button type="button" class="btn btn-sm f3-fold" disabled>
              <span class="f3-when-folded">{t(lang, 'floors.unfold')}</span>
              <span class="f3-when-up">{t(lang, 'floors.fold')}</span>
            </button>
            <button type="button" class="btn btn-sm f3-bridges" aria-pressed="false" disabled>{t(lang, 'floors.bridgesOnly')}</button>
            <button type="button" class="icon-btn f3-reset" aria-label={t(lang, 'floors.reset')} title={t(lang, 'floors.reset')} disabled>
              <Icon name="fit" size={16} />
            </button>
          </div>
        </div>
      </div>
      <aside class="f3-info" id="f3-info" aria-label={t(lang, 'inspector.aria')} hidden></aside>
    </div>
    <div class="f3-foot">
      <ul class="f3-legend" aria-hidden="true">
        <li>
          <svg width="34" height="10" viewBox="0 0 34 10"><defs><linearGradient id="f3-grad" x1="0" x2="1"><stop offset="0" stop-color="#3987e5" /><stop offset="1" stop-color="#199e70" /></linearGradient></defs><path d="M1,8 C10,-2 24,-2 33,8" fill="none" stroke="url(#f3-grad)" stroke-width="2" /></svg>
          {t(lang, 'floors.legendBridge')}
        </li>
        <li>
          <svg width="34" height="10" viewBox="0 0 34 10"><path d="M1,8 C10,4 24,4 33,8" fill="none" style="stroke: var(--muted)" stroke-width="1.4" /></svg>
          {t(lang, 'floors.legendArc')}
        </li>
        <li>
          <svg width="34" height="10" viewBox="0 0 34 10"><line x1="1" y1="5" x2="33" y2="5" style="stroke: var(--danger)" stroke-width="1.6" stroke-dasharray="2 3" /></svg>
          {t(lang, 'floors.legendChallenge')}
        </li>
        <li>
          <svg width="34" height="10" viewBox="0 0 34 10"><line x1="1" y1="5" x2="33" y2="5" style="stroke: var(--muted)" stroke-width="1.4" stroke-dasharray="6 4" /></svg>
          {t(lang, 'floors.legendDashed')}
        </li>
      </ul>
      <p class="f3-hint">
        <span class="f3-hint-up f3-hint-mouse">{t(lang, 'floors.hint')}</span>
        <span class="f3-hint-up f3-hint-touch">{t(lang, 'floors.hintTouch')}</span>
        <span class="f3-hint-folded">{t(lang, 'floors.hintFolded')}</span>
      </p>
    </div>
  </div>
</section>

<script>
  const section = document.getElementById('floors')!;
  const root = section.dataset.root!;
  const strings = JSON.parse(section.dataset.i18n!);
  const canvas = document.getElementById('f3-canvas')!;
  const ui = document.getElementById('f3-ui')!;
  const info = document.getElementById('f3-info')!;
  const foldBtn = ui.querySelector('.f3-fold') as HTMLButtonElement;
  const bridgesBtn = ui.querySelector('.f3-bridges') as HTMLButtonElement;
  const resetBtn = ui.querySelector('.f3-reset') as HTMLButtonElement;

  let view: any = null;
  let pending: { branches?: Set<string>; kinds?: Set<string> } = {};
  window.addEventListener('atlas:filter', (ev: Event) => {
    pending = (ev as CustomEvent).detail;
    if (view) {
      view.setFilter(pending.branches);
      view.setKinds(pending.kinds);
    }
  });

  async function mount() {
    try {
      const [{ mountFloors }, data] = await Promise.all([
        import('../lib/floors3d.js'),
        fetch(`${root}/graph.json`).then((r) => r.json()),
      ]);
      canvas.innerHTML = '';
      view = mountFloors({ el: canvas, overlay: ui, infoEl: info, data, root, strings });
      window.addEventListener('themechange', () => view.applyTheme());
      if (pending.branches) view.setFilter(pending.branches);
      if (pending.kinds) view.setKinds(pending.kinds);
      for (const b of [foldBtn, bridgesBtn, resetBtn]) b.disabled = false;
      // folded, the map is a fixed picture: nothing to reset, other words below
      const sync = () => {
        const folded = ui.classList.contains('is-folded');
        section.classList.toggle('is-folded', folded);
        resetBtn.disabled = folded;
      };
      new MutationObserver(sync).observe(ui, { attributes: true, attributeFilter: ['class'] });
      sync();
      foldBtn.addEventListener('click', () => view.toggleFold());
      bridgesBtn.addEventListener('click', () => {
        const on = view.toggleBridges();
        bridgesBtn.setAttribute('aria-pressed', String(on));
        ui.classList.toggle('is-bridges', on);
      });
      resetBtn.addEventListener('click', () => view.resetView());
    } catch (err) {
      canvas.innerHTML = `<p class="f3-loading">${strings.error3d}</p>`;
      console.error('floors 3d:', err);
    }
  }

  // three.js is heavy: start loading a little before the section scrolls in
  const io = new IntersectionObserver(
    (entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        io.disconnect();
        mount();
      }
    },
    { rootMargin: '700px 0px' },
  );
  io.observe(section);
</script>

<style is:global>
  .floors {
    position: relative;
    padding: 6rem 0 5rem;
    background:
      radial-gradient(900px 460px at 20% 30%, var(--glow-1), transparent 70%),
      radial-gradient(760px 420px at 85% 60%, var(--glow-2), transparent 70%),
      var(--page);
    border-top: 1px solid var(--ring);
    border-bottom: 1px solid var(--ring);
  }

  .floors-head {
    max-width: 780px;
  }

  .f3-frame {
    position: relative;
  }

  .f3-stage {
    position: relative;
    height: min(72vh, 660px);
    min-height: 460px;
    border-radius: var(--radius);
    border: 1px solid var(--ring);
    overflow: hidden;
    background:
      radial-gradient(70% 60% at 50% 40%, color-mix(in srgb, var(--surface) 70%, transparent), transparent),
      color-mix(in srgb, var(--page) 60%, transparent);
  }

  .f3-canvas {
    position: absolute;
    inset: 0;
    cursor: grab;
  }

  .f3-canvas:active {
    cursor: grabbing;
  }

  /* folded: a still picture, nothing to grab */
  .f3-canvas.is-fixed,
  .f3-canvas.is-fixed:active {
    cursor: default;
  }

  .f3-canvas canvas {
    display: block;
  }

  .f3-loading {
    margin: 0;
    padding-top: 28%;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* the HTML label layer floats over the canvas but lets the pointer through */
  .f3-labels {
    position: absolute;
    top: 0;
    left: 0;
    pointer-events: none;
  }

  .f3-floor {
    pointer-events: auto;
    appearance: none;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.18rem 0.7rem 0.22rem 0.55rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--bc) 45%, transparent);
    background: color-mix(in srgb, var(--page) 75%, transparent);
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 1.1rem;
    line-height: 1.1;
    white-space: nowrap;
    cursor: default;
    transition: opacity 0.2s;
  }

  .f3-floor.is-dim {
    opacity: 0.4;
  }

  .f3-floor-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--bc);
  }

  .f3-lane {
    font-family: var(--font-sans);
    font-size: 9.5px;
    font-weight: 620;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.25s;
  }

  .f3-lane.is-on {
    opacity: 0.95;
  }

  .f3-year {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--muted);
    white-space: nowrap;
  }

  .f3-label {
    padding: 1px 7px 2px;
    border-radius: 7px;
    border: 1px solid var(--ring);
    background: color-mix(in srgb, var(--page) 80%, transparent);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 560;
    white-space: nowrap;
  }

  .f3-label.is-self {
    font-weight: 700;
    border-color: var(--ink-2);
  }

  /* overlay chrome */
  .f3-ui {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .f3-caption {
    position: absolute;
    top: 0.95rem;
    left: 1rem;
    margin: 0;
    max-width: 46%;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .f3-controls {
    position: absolute;
    top: 0.8rem;
    right: 0.8rem;
    display: flex;
    gap: 0.4rem;
    pointer-events: auto;
  }

  .f3-controls .btn,
  .f3-controls .icon-btn {
    background: color-mix(in srgb, var(--surface) 85%, transparent);
    backdrop-filter: blur(6px);
  }

  .f3-controls .btn[aria-pressed='true'] {
    background: var(--ink);
    color: var(--page);
    border-color: var(--ink);
  }

  .f3-controls button:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .f3-ui .f3-when-up,
  .f3-ui.is-folded .f3-when-folded {
    display: inline;
  }

  .f3-ui .f3-when-folded,
  .f3-ui.is-folded .f3-when-up {
    display: none;
  }

  /* bridges only: the caption says what is left on screen */
  .f3-caption .f3-when-bridges,
  .f3-ui.is-bridges .f3-caption .f3-when-up,
  .f3-ui.is-bridges .f3-caption .f3-when-folded {
    display: none;
  }

  .f3-ui.is-bridges .f3-caption .f3-when-bridges {
    display: inline;
    color: var(--ink-2);
  }

  .f3-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem 1.5rem;
    margin-top: 0.9rem;
  }

  .f3-legend {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.5rem;
    font-size: 0.78rem;
    color: var(--ink-2);
  }

  .f3-legend li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .f3-hint {
    margin: 0;
    font-size: 0.74rem;
    color: var(--muted);
  }

  .f3-hint-touch,
  .f3-hint-folded {
    display: none;
  }

  @media (hover: none) {
    .f3-hint-mouse {
      display: none;
    }

    .f3-hint-touch {
      display: inline;
    }
  }

  .floors.is-folded .f3-hint-up {
    display: none;
  }

  .floors.is-folded .f3-hint-folded {
    display: inline;
  }

  /* the relation under the pointer */
  .f3-tip {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 6;
    max-width: 320px;
    padding: 0.65rem 0.8rem 0.6rem;
    border-radius: 12px;
    background: var(--tooltip-bg);
    box-shadow: var(--shadow-lg);
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--ink-2);
    pointer-events: none;
  }

  .f3-tip-kicker {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .f3-tip-rel {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.95rem;
    line-height: 1.3;
    color: var(--ink);
  }

  .f3-tip-rel em,
  .f3-rel-h em {
    font-style: italic;
    color: var(--muted);
  }

  .f3-tip-rel em.t-challenges,
  .f3-rel-h em.t-challenges {
    color: var(--danger);
  }

  .f3-tip-years {
    display: block;
    margin-top: 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--muted);
  }

  .f3-tip p {
    margin: 0.45rem 0 0.35rem;
  }

  .f3-tip-hint {
    font-size: 0.68rem;
    color: var(--muted);
  }

  /* the card */
  /* the card floats over the stage (the picture slides aside for it) */
  .f3-info {
    position: absolute;
    top: 3.6rem;
    right: 0.8rem;
    bottom: 0.8rem;
    width: 340px;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 1.1rem 1.2rem 1.3rem;
    border-radius: var(--radius);
    border: 1px solid var(--ring);
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: var(--shadow-lg);
    font-size: 0.86rem;
    line-height: 1.5;
    animation: f3-in 0.3s var(--ease);
  }

  @keyframes f3-in {
    from {
      opacity: 0;
      transform: translateX(10px);
    }
  }

  .f3-close {
    position: absolute;
    top: 0.7rem;
    right: 0.7rem;
    width: 2rem;
    height: 2rem;
    font-size: 1.1rem;
  }

  .f3-info .chip {
    font-size: 0.74rem;
    padding-right: 2.2rem;
  }

  .f3-info h3 {
    margin: 0.6rem 0 0.2rem;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 2rem;
    line-height: 1.05;
  }

  .f3-info .f3-rel-h {
    font-size: 1.65rem;
    line-height: 1.15;
  }

  .f3-info .chip .dot + .dot {
    margin-left: -0.3em;
  }

  .f3-full {
    margin: 0 0 0.35rem;
    color: var(--ink-2);
  }

  .f3-meta {
    margin: 0 0 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
  }

  .f3-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.4rem;
    padding: 0.65rem 0.8rem;
    border-radius: 12px;
    border: 1px solid var(--ring);
    background: var(--page);
  }

  .f3-stats div {
    display: flex;
    flex-direction: column;
  }

  .f3-stats b {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 1.6rem;
    line-height: 1.1;
    color: var(--ink);
  }

  .f3-stats span {
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .f3-problem {
    margin: 0.9rem 0 0;
  }

  .f3-info h4 {
    margin: 1.1rem 0 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .f3-bridge-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .f3-bridge-list button {
    appearance: none;
    width: 100%;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.25rem 0.45rem;
    padding: 0.4rem 0.6rem;
    border-radius: 9px;
    border: 1px solid var(--ring);
    background: transparent;
    color: var(--ink-2);
    font: inherit;
    font-size: 0.8rem;
    text-align: left;
    cursor: pointer;
  }

  .f3-bridge-list button:hover {
    background: var(--surface-2);
    border-color: var(--ring-strong);
  }

  .f3-bridge-list .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    display: inline-block;
  }

  .f3-bridge-list strong {
    color: var(--ink);
    font-weight: 600;
  }

  .f3-bridge-list em {
    color: var(--muted);
  }

  .f3-bridge-list button > em:last-child {
    margin-left: auto;
    font-style: normal;
    font-size: 0.72rem;
  }

  .f3-y {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--muted);
  }

  .f3-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1.1rem;
  }

  @media (max-width: 760px) {
    .floors {
      padding: 4rem 0 3.5rem;
    }

    .f3-stage {
      height: 470px;
      min-height: 0;
    }

    /* a phone has no room beside the picture: the card follows below it */
    .f3-info {
      position: static;
      width: auto;
      margin-top: 0.8rem;
      box-shadow: none;
    }

    .f3-caption {
      display: none;
    }

    .f3-floor {
      font-size: 0.95rem;
    }
  }
</style>
