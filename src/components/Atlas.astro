---
/**
 * The atlas — the genealogy as a timeline map, flat or lifted into 3D
 * (logic in src/lib/atlas.js; the 3D view in src/lib/atlas3d.js, loaded on
 * first use). It reads /<lang>/graph.json, generated from src/content/, so
 * adding branches, nodes or tours needs no change here. UI strings arrive
 * through a data attribute.
 */
import Icon from './Icon.astro';
import { buildGraph } from '../lib/graph';
import { graphStrings, t, type Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const root = `${base}/${lang}`;
const graph = await buildGraph(lang);
const branchOf = new Map(graph.nodes.map((n) => [n.id, n.branch]));
const bridges = graph.edges.filter((e) => branchOf.get(e.source) !== branchOf.get(e.target)).length;
---

<section class="atlas" id="atlas" aria-label={t(lang, 'atlas.aria')} data-root={root} data-i18n={JSON.stringify(graphStrings(lang))}>
  <div class="at-head">
    <div class="at-pad at-toolbar">
      <div class="at-filters">
        <div class="at-group">
          <span class="at-group-label">{t(lang, 'atlas.branches')}</span>
          <div class="at-chips at-branches" role="group" aria-label={t(lang, 'atlas.branches')}></div>
        </div>
        <div class="at-group">
          <span class="at-group-label">{t(lang, 'atlas.kinds')}</span>
          <div class="at-chips at-kinds" role="group" aria-label={t(lang, 'atlas.kinds')}></div>
        </div>
      </div>
      <div class="at-tools">
        {
          graph.tours.length > 0 && (
            <div class="at-tours">
              <button type="button" class="btn btn-sm at-tours-btn" aria-expanded="false" aria-controls="at-tours-menu" title={t(lang, 'tour.menuHint')}>
                <Icon name="route" size={15} /><span class="at-tools-label">{t(lang, 'tour.menu')}</span>
              </button>
              <div class="at-tours-menu" id="at-tours-menu" role="group" aria-label={t(lang, 'tour.menu')} hidden />
            </div>
          )
        }
        <div class="at-mode" role="group" aria-label={t(lang, 'atlas.view')}>
          <button type="button" class="at-mode-btn" data-mode="2d" aria-pressed="true" title={t(lang, 'atlas.to2d')}><Icon name="map" size={15} /><span>2D</span></button>
          <button type="button" class="at-mode-btn" data-mode="3d" aria-pressed="false" title={t(lang, 'atlas.to3d')}><Icon name="layers" size={15} /><span>3D</span></button>
        </div>
        <div class="at-zoom-ctl" role="group" aria-label={t(lang, 'atlas.zoom')}>
          <button type="button" class="icon-btn at-zoom-out" aria-label={t(lang, 'atlas.zoomOut')} title={t(lang, 'atlas.zoomOut')}><Icon name="minus" size={16} /></button>
          <button type="button" class="icon-btn at-zoom-fit" aria-label={t(lang, 'atlas.zoomFit')} title={t(lang, 'atlas.zoomFit')}><Icon name="fit" size={16} /></button>
          <button type="button" class="icon-btn at-zoom-in" aria-label={t(lang, 'atlas.zoomIn')} title={t(lang, 'atlas.zoomIn')}><Icon name="plus" size={16} /></button>
        </div>
        <p class="at-status" role="status" hidden></p>
      </div>
    </div>
    <div class="at-pad at-axis">
      <svg aria-hidden="true"></svg>
      <div class="at-hud">
        <p class="at-hud-caption" aria-live="polite">
          <span class="at-when-all">{t(lang, 'atlas.caption3d')}</span>
          <span class="at-when-bridges">{t(lang, 'atlas.captionBridges').replace('{n}', String(bridges))}</span>
        </p>
        <button type="button" class="at-chip at-chip-sm at-bridges" aria-pressed="false" title={t(lang, 'atlas.bridgesHint')}>
          <svg width="22" height="10" viewBox="0 0 22 10" aria-hidden="true"><defs><linearGradient id="at-bridge-grad" x1="0" x2="1"><stop offset="0" stop-color="#3987e5" /><stop offset="1" stop-color="#199e70" /></linearGradient></defs><path d="M1,9 C6,0 16,0 21,9" fill="none" stroke="url(#at-bridge-grad)" stroke-width="2" /></svg>
          <span>{t(lang, 'atlas.bridgesOnly')}</span>
        </button>
        <span class="at-hud-hint">
          <span class="at-hint-mouse">{t(lang, 'atlas.hint3d')}</span>
          <span class="at-hint-touch">{t(lang, 'atlas.hint3dTouch')}</span>
        </span>
      </div>
    </div>
  </div>

  <div class="at-pad">
    <div class="at-scroller">
      <div class="at-stage">
        <div class="at-captions"></div>
        <svg class="at-svg" role="group" aria-label={t(lang, 'graph.ariaTimeline')}></svg>
      </div>
    </div>
    <div class="at-3d" role="region" tabindex="0" aria-label={t(lang, 'atlas.aria3d')} hidden></div>
    <noscript>
      <p class="at-noscript">
        {t(lang, 'graph.noscript')} <a href={`${root}/works/`}>{t(lang, 'nav.works')} →</a>
      </p>
    </noscript>
  </div>

  <div class="at-timebar">
    <div class="at-pad at-timebar-row">
      <button type="button" class="at-play" aria-label={t(lang, 'graph.play')} title={t(lang, 'graph.play')}>
        <Icon name="play" size={16} class="i-play" />
        <Icon name="pause" size={16} class="i-pause" />
      </button>
      <div class="at-histo-wrap">
        <svg class="at-histo" aria-hidden="true"></svg>
        <input class="at-range" type="range" min="0" step="1" aria-label={t(lang, 'atlas.year')} />
      </div>
      <output class="at-readout" aria-live="off"></output>
      <div class="at-types-wrap">
        <span class="at-group-label">{t(lang, 'atlas.relations')}</span>
        <div class="at-chips at-types" role="group" aria-label={t(lang, 'atlas.relations')}></div>
      </div>
    </div>
  </div>

  <div class="at-tooltip" role="tooltip" hidden></div>
  <p class="sr-only at-announce" aria-live="polite"></p>
</section>

<aside class="inspector" id="inspector" aria-label={t(lang, 'inspector.aria')} hidden></aside>

<script>
  import { mountAtlas } from '../lib/atlas.js';

  const el = document.getElementById('atlas')!;
  const root = el.dataset.root!;
  const strings = JSON.parse(el.dataset.i18n!);

  (async () => {
    // capsule widths are measured with the real face, and every later scroll
    // target assumes the page above has stopped reflowing — so wait for the
    // faces in use (briefly; a slow font must not hold the atlas hostage)
    await Promise.race([
      document.fonts?.load('520 12px "Inter Variable"').then(() => document.fonts.ready),
      new Promise((r) => setTimeout(r, 2000)),
    ]).catch(() => {});
    const data = await (await fetch(`${root}/graph.json`)).json();
    // (kept on the element: the page's own scripts and the tests reach it there)
    (el as HTMLElement & { atlas?: unknown }).atlas = mountAtlas({ el, data, root, strings });
  })().catch((err) => console.error('atlas:', err));
</script>

<style is:global>
  .atlas {
    position: relative;
    --at-pad: 1.5rem;
    /* land flush under the site header, not under html's scroll padding */
    scroll-margin-top: -16px;
  }

  .at-pad {
    max-width: 1680px;
    margin: 0 auto;
    padding-left: var(--at-pad);
    padding-right: var(--at-pad);
  }

  /* ---- sticky head: filters + the year axis ---- */
  .at-head {
    position: sticky;
    top: var(--header-h);
    z-index: 31;
    background: var(--glass);
    backdrop-filter: saturate(150%) blur(14px);
    -webkit-backdrop-filter: saturate(150%) blur(14px);
    border-top: 1px solid var(--ring);
    border-bottom: 1px solid var(--ring);
  }

  .at-toolbar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-top: 0.7rem;
    padding-bottom: 0.35rem;
  }

  .at-filters {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 0.6rem 1.75rem;
    flex-wrap: wrap;
  }

  .at-group,
  .at-types-wrap {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
  }

  .at-group-label {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }

  .at-chips {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .at-chip {
    appearance: none;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    height: 1.95rem;
    padding: 0 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--ring-strong);
    background: var(--surface);
    color: var(--ink);
    font-size: 0.8rem;
    font-weight: 550;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 0.2s, background-color 0.2s, border-color 0.2s;
  }

  .at-chip:hover {
    background: var(--surface-2);
    border-color: var(--muted);
  }

  .at-chip.is-off {
    background: transparent;
    border-style: dashed;
    color: var(--muted);
  }

  .at-chip.is-off .at-chip-dot {
    background: transparent;
    box-shadow: inset 0 0 0 1.5px var(--bc);
  }

  .at-chip.is-off svg {
    opacity: 0.55;
  }

  .at-chip-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--bc);
  }

  .at-chip svg path {
    fill: currentColor;
  }

  .at-chip-n {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--muted);
  }

  /* ---- tools: tours, 2D/3D, zoom ---- */
  .at-tools {
    position: relative;
    flex: none;
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  /* while the tours menu is open the head (and the menu in it) rises above
     the inspector */
  .atlas.is-menu-open .at-head {
    z-index: 50;
  }

  .at-status {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    z-index: 2;
    margin: 0;
    max-width: min(320px, calc(100vw - 24px));
    padding: 0.5rem 0.75rem;
    border-radius: 10px;
    background: var(--tooltip-bg);
    box-shadow: var(--shadow-lg);
    font-size: 0.8rem;
    color: var(--ink-2);
  }

  .at-zoom-ctl {
    flex: none;
    display: flex;
    gap: 0.3rem;
  }

  .at-mode {
    display: inline-flex;
    padding: 2px;
    border-radius: 999px;
    border: 1px solid var(--ring-strong);
    background: var(--surface);
  }

  .at-mode-btn {
    appearance: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    height: calc(1.95rem - 6px);
    padding: 0 0.7rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 0.76rem;
    font-weight: 650;
    letter-spacing: 0.03em;
    cursor: pointer;
    transition: background-color 0.25s, color 0.25s;
  }

  .at-mode-btn:hover {
    color: var(--ink);
  }

  .at-mode-btn[aria-pressed='true'] {
    background: var(--ink);
    color: var(--page);
  }

  /* three.js is on its way */
  .atlas.is-loading-3d .at-mode-btn[data-mode='3d'] {
    animation: at-busy 0.8s ease-in-out infinite alternate;
  }

  @keyframes at-busy {
    to {
      opacity: 0.4;
    }
  }


  .at-tours-btn {
    height: 1.95rem;
    gap: 0.4rem;
  }

  .at-tours-btn[aria-expanded='true'] {
    background: var(--surface-2);
    border-color: var(--muted);
  }

  .at-tours-menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    z-index: 40;
    width: min(360px, calc(100vw - 24px));
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.45rem;
    border-radius: 14px;
    background: var(--surface);
    box-shadow: var(--shadow-lg);
  }

  .at-tour-pick {
    appearance: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.7rem 0.85rem 0.75rem;
    border-radius: 10px;
    border: 1px solid var(--ring);
    background: transparent;
    color: var(--ink-2);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: background-color 0.2s, border-color 0.2s;
  }

  .at-tour-pick:hover,
  .at-tour-pick:focus-visible {
    background: var(--surface-2);
    border-color: var(--ring-strong);
  }

  .at-tour-pick-title {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    line-height: 1.15;
    color: var(--ink);
  }

  .at-tour-pick-sum {
    font-size: 0.8rem;
    line-height: 1.45;
  }

  .at-tour-pick-n {
    margin-top: 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .at-zoom-ctl .icon-btn {
    width: 1.95rem;
    height: 1.95rem;
  }

  .at-axis svg {
    display: block;
    width: 100%;
    height: 28px;
  }

  /* in 3D the axis row carries the caption, "bridges only" and the hints */
  .at-hud {
    display: none;
  }

  .atlas.is-3d .at-axis svg {
    display: none;
  }

  .atlas.is-3d .at-hud {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    height: 28px;
  }

  .at-hud-caption {
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    line-height: 1;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .at-when-bridges,
  .atlas.is-bridges .at-when-all {
    display: none;
  }

  .atlas.is-bridges .at-when-bridges {
    display: inline;
    color: var(--ink-2);
  }

  .at-chip-sm {
    height: 22px;
    padding: 0 0.6rem;
    font-size: 0.72rem;
  }

  .at-bridges[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--page);
  }

  .at-hud-hint {
    flex: none;
    font-size: 0.7rem;
    color: var(--muted);
  }

  .at-hint-touch {
    display: none;
  }

  @media (hover: none) {
    .at-hint-mouse {
      display: none;
    }

    .at-hint-touch {
      display: inline;
    }
  }

  .at-year {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    fill: var(--muted);
    transition: opacity 0.2s;
  }

  .at-year.is-hidden {
    display: none;
  }

  .at-year.is-future {
    opacity: 0.32;
  }

  .at-year.is-now {
    fill: var(--ink);
    font-weight: 700;
  }

  /* ---- the 3D stage: the same map, lifted (src/lib/atlas3d.js) ---- */
  .atlas.is-3d .at-scroller {
    display: none;
  }

  .at-3d {
    position: relative;
    margin-top: 0.9rem;
    border-radius: var(--radius);
    overflow: hidden;
    outline: none;
  }

  /* the room around the building fades in once it is up — at the moment of
     the switch the stage looks exactly like the flat chart did */
  .at-3d::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: radial-gradient(70% 62% at 50% 42%, color-mix(in srgb, var(--surface) 72%, transparent), transparent);
    box-shadow: inset 0 0 0 1px var(--ring);
    opacity: 0;
    transition: opacity 1.4s ease;
  }

  .atlas.is-3d-up .at-3d::before {
    opacity: 1;
  }

  .at-3d:focus-visible:not([data-pointer])::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 2px var(--accent);
    pointer-events: none;
    z-index: 3;
  }

  .a3-gl {
    position: relative;
    z-index: 1;
    display: block;
    cursor: grab;
  }

  .a3-gl:active {
    cursor: grabbing;
  }

  .a3-labels {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    pointer-events: none;
  }

  /* the names inside the capsules, while the map lies flat: the atlas's own
     type, at the atlas's own scale */
  .a3-cap-text {
    font-family: var(--font-sans);
    font-size: calc(12px * var(--s, 1));
    font-weight: 520;
    line-height: 1;
    color: var(--ink-2);
    white-space: nowrap;
  }

  .a3-label {
    padding: 1px 7px 2px;
    border-radius: 7px;
    border: 1px solid var(--ring);
    background: color-mix(in srgb, var(--page) 82%, transparent);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 560;
    white-space: nowrap;
  }

  .a3-label.is-self {
    font-weight: 700;
    border-color: var(--ink-2);
  }

  .a3-floor {
    pointer-events: auto;
    appearance: none;
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    padding: 0.16rem 0.7rem 0.22rem 0.55rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--bc) 45%, transparent);
    background: color-mix(in srgb, var(--page) 76%, transparent);
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 1.1rem;
    line-height: 1.1;
    white-space: nowrap;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .a3-floor:hover {
    border-color: var(--bc);
  }

  .a3-floor.is-dim {
    opacity: 0.4;
  }

  .a3-floor-dot {
    align-self: center;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--bc);
  }

  .a3-floor-n {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--muted);
  }

  .a3-lane {
    font-family: var(--font-sans);
    font-size: 9.5px;
    font-weight: 620;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.25s;
  }

  .a3-lane.is-on {
    opacity: 0.95;
  }

  /* flat, the floor and lane names wear the atlas's caption style */
  .a3-labels.is-flat .a3-lane {
    padding: 0 0.35rem;
    border-radius: 4px;
    font-size: clamp(8.5px, calc(16px * var(--s, 0.7)), 10.5px);
    line-height: 1.25;
    background: color-mix(in srgb, var(--page) 60%, transparent);
  }

  .a3-labels.is-flat .a3-floor {
    gap: 0.55rem;
    padding: 0 0.55rem 0.1rem 0.4rem;
    border-color: transparent;
    border-radius: 8px;
    background: color-mix(in srgb, var(--page) 72%, transparent);
    font-size: clamp(0.95rem, calc(1.7rem * var(--s, 0.7)), 1.5rem);
    line-height: 1.15;
  }

  .a3-labels.is-flat .a3-floor-dot {
    width: 9px;
    height: 9px;
  }

  .a3-labels.is-flat .a3-floor-n {
    font-size: 0.7rem;
  }

  .a3-year {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--muted);
    white-space: nowrap;
    transition: color 0.2s;
  }

  .a3-year.is-future {
    color: color-mix(in srgb, var(--muted) 45%, transparent);
  }

  .a3-year.is-now {
    color: var(--ink);
    font-weight: 700;
  }

  /* the time machine's year, large over the stage while the years run */
  .a3-now {
    position: absolute;
    top: 0.9rem;
    right: 1.3rem;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    line-height: 1;
    pointer-events: none;
    opacity: 0;
  }

  .a3-now b {
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    font-weight: 400;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .a3-now span {
    margin-top: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ---- the chart ---- */
  .at-scroller {
    position: relative;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
    margin-top: 0.9rem;
    padding-bottom: 0.6rem;
  }

  .at-scroller.can-pan {
    cursor: grab;
  }

  .at-scroller.is-dragging {
    cursor: grabbing;
  }

  .at-stage {
    position: relative;
    display: flex;
  }

  .at-svg {
    display: block;
    flex: none;
    overflow: visible;
    user-select: none;
    -webkit-user-select: none;
  }

  .at-band {
    fill: color-mix(in srgb, var(--bc) 4.5%, transparent);
    stroke: color-mix(in srgb, var(--bc) 13%, transparent);
    stroke-width: 1;
  }

  .at-lane-rule {
    stroke: var(--grid);
    stroke-dasharray: 2 6;
  }

  .at-grid line {
    stroke: var(--grid);
    stroke-width: 1;
    opacity: 0.45;
  }

  .at-now {
    stroke: var(--ink);
